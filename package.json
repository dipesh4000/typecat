{
  "name": "typecat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run verifier:check && npm run vercel:check && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifier": "tsx server/index.ts",
    "verifier:check": "tsc -p server/tsconfig.json",
    "vercel:check": "tsx scripts/check-vercel.ts",
    "contracts:check": "tsx scripts/contracts.ts",
    "contracts:deploy": "tsx scripts/contracts.ts --deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@openzeppelin/contracts": "^5.6.1",
    "@privy-io/react-auth": "^3.48.1",
    "@smoothsend/sdk": "^2.3.8",
    "@stripe/stripe-js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "solc": "^0.8.37",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "viem": "^2.57.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
