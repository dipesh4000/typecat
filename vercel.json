{
  "headers": [
    {
      "source": "/(.*\\.m4a)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mp4"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.m4a$).*)",
      "destination": "/index.html"
    }
  ]
}
