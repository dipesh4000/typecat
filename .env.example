# Add these to the existing TypeCat Vercel project's environment variables.
# Vercel Root Directory: typecat (or repository root if it already contains package.json).
VITE_PRIVY_APP_ID=
VITE_SMOOTHSEND_KEY=
VITE_NETWORK=fuji
# Fill both address variables after deploying TypeCatGame on Fuji.
VITE_GAME_ADDRESS=
VITE_DEPLOY_BLOCK=
# Frontend and backend deploy together; no separate backend hostname needed.
VITE_VERIFIER_URL=/api

# Server-only variables in the SAME Vercel project. Never add VITE_ to private keys.
NETWORK=fuji
GAME_ADDRESS=
VERIFIER_PRIVATE_KEY=
ALLOWED_ORIGINS=https://typecat-rust.vercel.app
# Optional RPC override, used only by the server:
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployment machine ONLY. Do not add this key to Vercel.
# DEPLOYER_PRIVATE_KEY=
